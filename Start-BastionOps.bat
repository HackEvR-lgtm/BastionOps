@echo off & setlocal EnableDelayedExpansion & chcp 65001 >nul & title BastionOps - Inicializador Automático & color 0B & echo. & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        BASTION OPS - Sistema de Protección Avanzada          ║ & echo ║              Inicializador Automático v2.0                     ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Verificando privilegios de administrador... & net session >nul 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Este script requiere privilegios de Administrador. & echo [*] Reiniciando con privilegios elevados... & powershell -Command Start-Process '%~f0' -Verb runAs & exit /b ) & echo [✓] Privilegios de administrador confirmados. & echo. & echo [*] Verificando requisitos del sistema... & where dotnet >nul 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: .NET SDK no encontrado. & echo [*] Instalando .NET 8.0 SDK... & powershell -Command Invoke-WebRequest -Uri 'https://download.visualstudio.microsoft.com/download/pr/xxx/dotnet-sdk-8.0.xxx-win-x64.exe' -OutFile '%TEMP%dotnet-sdk.exe' & start /wait %TEMP%dotnet-sdk.exe /quiet /norestart & echo [✓] .NET SDK instalado. ) & echo [✓] .NET SDK detectado. & echo. & echo [*] Verificando Visual Studio Build Tools... & where msbuild >nul 2>&1 & if %errorLevel% neq 0 ( echo [!] ADVERTENCIA: MSBuild no encontrado. & echo [*] Algunas funciones de compilación pueden estar limitadas. ) else ( echo [✓] MSBuild detectado. ) & echo. & echo [*] Verificando Windows SDK y WDK para driver... & if exist C:Program Files (x86)Windows Kits10 ( echo [✓] Windows SDK detectado. ) else ( echo [!] ADVERTENCIA: Windows SDK no detectado. El driver kernel no podrá compilarse. ) & echo. & echo [*] Configurando entorno de trabajo... & set REPO_ROOT=%~dp0 & set SRC_DIR=%REPO_ROOT%src & set BUILD_DIR=%REPO_ROOT%build & set LOGS_DIR=%REPO_ROOT%logs & set CONFIG_DIR=%REPO_ROOT%config & set INSTALL_DIR=C:Program FilesBastionOps & set