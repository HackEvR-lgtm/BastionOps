==5 goto RunTests & if %choice%==6 goto InstallService & if %choice%==7 goto UninstallService & if %choice%==8 goto StartService & if %choice%==9 goto StopService & if %choice%==10 goto PanicMode & if %choice%==11 goto ViewLogs & if %choice%==12 goto UpdateFromGitHub & if %choice%==0 goto End & echo [!] Opción inválida. & pause & goto Menu & :BuildUserMode & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        COMPILANDO MODO USUARIO (User-Mode)                  ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Restaurando paquetes NuGet... & dotnet restore %SRC_DIR%usermodeCapabilityDenialSystem.csproj >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Falló la restauración de paquetes. & echo [*] Revisa: %LOG_FILE% & pause & goto Menu ) & echo [✓] Paquetes restaurados. & echo. & echo [*] Compilando en modo Release... & dotnet build %SRC_DIR%usermodeCapabilityDenialSystem.csproj -c Release --no-restore >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Falló la compilación. & echo [*] Revisa: %LOG_FILE% & pause & goto Menu ) & echo [✓] Compilación exitosa. & echo. & echo [*] Publicando aplicación standalone... & dotnet publish %SRC_DIR%usermodeCapabilityDenialSystem.csproj -c Release --self-contained true -r win-x64 -o %BUILD_DIR%usermode --no-build >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Falló la publicación. & echo [*] Revisa: %LOG_FILE% & pause & goto Menu ) & echo [✓] Publicación completada en: %BUILD_DIR%usermode & echo. & echo [*] Copiando configuración... & xcopy /Y %CONFIG_DIR%whitelist.json %BUILD_DIR%usermode >> %LOG_FILE% 2>&1 & echo [✓] Configuración copiada. & echo. & echo [*] Ejecutando BastionOps... & start %BUILD_DIR%usermodeCapabilityDenialSystem.exe --tray & echo [✓] BastionOps iniciado en modo bandeja. & echo. & pause & goto Menu & :BuildDriver & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        COMPILANDO DRIVER KERNEL-MODE                        ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Verificando WDK (Windows Driver Kit)... & if not exist C:Program Files (x86)Windows Kits10bin ( echo [!] ERROR: WDK no instalado. & echo [*] Descarga desde: https://docs.microsoft.com/en-us/windows-hardware/drivers/download-the-wdk & pause & goto Menu ) & echo [✓] WDK detectado. & echo. & echo [*] Buscando MSBuild para Visual Studio... & for /f delims= %%i in ('dir /b /s C:Program FilesMicrosoft Visual Studio2022*MSBuild.exe 2^>nul') do set MSBUILD_PATH=%%i & if not defined MSBUILD_PATH ( echo [!] ERROR: MSBuild no encontrado. & echo [*] Instala Visual Studio 2022 con carga de trabajo C++. & pause & goto Menu ) & echo [✓] MSBuild encontrado: %MSBUILD_PATH% & echo. & echo [*] Compilando driver... & %MSBUILD_PATH% %SRC_DIR%kernelmodeCdsProtectDriver.vcxproj /p:Configuration=Release /p:Platform=x64 >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Falló la compilación del driver. & echo [*] Revisa: %LOG_FILE% & pause & goto Menu ) & echo [✓] Driver compilado exitosamente. & echo. & echo [*] Copiando archivos del driver... & if exist %SRC_DIR%kernelmodex64ReleaseCdsProtectDriver.sys ( copy /Y %SRC_DIR%kernelmodex64ReleaseCdsProtectDriver.sys %BUILD_DIR%driver >> %LOG_FILE% 2>&1 & copy /Y %SRC_DIR%kernelmodeCdsProtectDriver.inf %BUILD_DIR%driver >> %LOG_FILE% 2>&1 & echo [✓] Driver copiado a: %BUILD_DIR%driver ) else ( echo [!] ADVERTENCIA: No se encontró el archivo .sys del driver. ) & echo. & pause & goto Menu & :BuildInstaller & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        COMPILANDO INSTALADOR                                 ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Compilando instalador... & dotnet build %SRC_DIR%installerCdsInstaller.csproj -c Release >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Falló la compilación del instalador. & echo [*] Revisa: %LOG_FILE% & pause & goto Menu ) & echo [✓] Instalador compilado. & echo. & echo [*] Publicando instalador... & dotnet publish %SRC_DIR%installerCdsInstaller.csproj -c Release --self-contained true -r win-x64 -o %BUILD_DIR%installer --no-build >> %LOG_FILE% 2>&1 & echo [✓] Instalador publicado en: %BUILD_DIR%installer & echo. & pause & goto Menu & :BuildAll & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        COMPILANDO TODO (User-Mode + Driver + Instalador)      ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & call :BuildUserMode & echo. & call :BuildDriver & echo. & call :BuildInstaller & echo. & echo [✓✓✓] TODAS LAS COMPILACIONES COMPLETADAS. & echo. & pause & goto Menu & :RunTests & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        EJECUTANDO TESTS                                      ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Compilando tests... & dotnet build %REPO_ROOT%testsBastionOps.TestsBastionOps.Tests.csproj >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Falló la compilación de tests. & echo [*] Revisa: %LOG_FILE% & pause & goto Menu ) & echo [✓] Tests compilados. & echo. & echo [*] Ejecutando tests... & dotnet test %REPO_ROOT%testsBastionOps.TestsBastionOps.Tests.csproj --verbosity normal >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ALGUNOS TESTS FALLARON. Revisa: %LOG_FILE% ) else ( echo [✓] TODOS LOS TESTS PASARON. ) & echo. & pause & goto Menu & :InstallService & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        INSTALANDO SERVICIO DE WINDOWS                        ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Creando directorio de instalación... & if not exist %INSTALL_DIR% mkdir %INSTALL_DIR% & echo [✓] Directorio creado. & echo. & echo [*] Copiando archivos... & xcopy /E /I /Y %BUILD_DIR%usermode* %INSTALL_DIR% >> %LOG_FILE% 2>&1 & echo [✓] Archivos copiados. & echo. & echo [*] Instalando servicio... & sc create BastionOps binPath= %INSTALL_DIR%CapabilityDenialSystem.exe start= auto DisplayName= BastionOps >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: No se pudo crear el servicio. & echo [*] Es posible que ya exista o falten permisos. ) else ( echo [✓] Servicio instalado. & echo. & echo [*] Configurando descripción... & sc description BastionOps Sistema de Protección Avanzada contra Screen Capture, Keyloggers, Inyección de Procesos y Amenazas de Red. >> %LOG_FILE% 2>&1 & echo [✓] Descripción configurada. ) & echo. & pause & goto Menu & :UninstallService & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        DESINSTALANDO SERVICIO DE WINDOWS                     ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Deteniendo servicio... & sc stop BastionOps >> %LOG_FILE% 2>&1 & echo [*] Eliminando servicio... & sc delete BastionOps >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: No se pudo eliminar el servicio. ) else ( echo [✓] Servicio eliminado. & echo. & echo [*] Limpiando archivos... & if exist %INSTALL_DIR% rmdir /S /Q %INSTALL_DIR% & echo [✓] Archivos eliminados. ) & echo. & pause & goto Menu & :StartService & cls & echo [*] Iniciando servicio BastionOps... & sc start BastionOps >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: No se pudo iniciar el servicio. ) else ( echo [✓] Servicio iniciado. ) & echo. & pause & goto Menu & :StopService & cls & echo [*] Deteniendo servicio BastionOps... & sc stop BastionOps >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: No se pudo detener el servicio. ) else ( echo [✓] Servicio detenido. ) & echo. & pause & goto Menu & :PanicMode & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        ⚠️  MODO PÁNICO ACTIVADO  ⚠️                          ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [!] ESTA ACCIÓN BLOQUEARÁ TODO EL TRÁFICO DE RED SALIENTE. & echo [!] Solo las conexiones DNS a servidores permitidos funcionarán. & echo. & set /p confirm=¿Está seguro? (SI/NO):  & if /I not %confirm%==SI goto Menu & echo. & echo [*] Activando modo pánico... & echo [*] Creando reglas de firewall... & netsh advfirewall firewall add rule name=BastionOps_Panic_Block dir=out action=block profile=any >> %LOG_FILE% 2>&1 & netsh advfirewall firewall add rule name=BastionOps_Panic_DNS dir=out action=allow protocol=udp remoteport=53 profile=any >> %LOG_FILE% 2>&1 & echo [✓] Modo pánico ACTIVADO. & echo [!] Para desactivar, ejecute: netsh advfirewall firewall delete rule name=BastionOps_Panic_Block & echo. & pause & goto Menu & :ViewLogs & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        LOGS EN TIEMPO REAL                                   ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Últimas 50 líneas del log principal: & echo. & if exist %DATA_DIR%logsaudit.log ( powershell -Command Get-Content -Path '%DATA_DIR%logsaudit.log' -Tail 50 ) else ( echo [!] No se encontró el archivo de log. ) & echo. & pause & goto Menu & :UpdateFromGitHub & cls & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        ACTUALIZANDO DESDE GITHUB                             ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Verificando Git... & where git >nul 2>&1 & if %errorLevel% neq 0 ( echo [!] Git no encontrado. Descargando... & powershell -Command Invoke-WebRequest -Uri 'https://github.com/git-for-windows/git/releases/download/v2.42.0.windows.2/Git-2.42.0.2-64-bit.exe' -OutFile '%TEMP%git-installer.exe' & start /wait %TEMP%git-installer.exe /VERYSILENT /NORESTART ) & echo [✓] Git detectado. & echo. & echo [*] Realizando pull desde origin/main... & cd %REPO_ROOT% & git pull origin main >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [!] ERROR: Falló el pull. & echo [*] Revisa: %LOG_FILE% ) else ( echo [✓] Repositorio actualizado. & echo [*] Recompilando... & call :BuildAll ) & echo. & pause & goto Menu & :CreateDefaultConfig & echo { > %CONFIG_DIR%whitelist.json & echo   system_version: 1.0.0, >> %CONFIG_DIR%whitelist.json & echo   security_level: MAXIMUM_ISOLATION, >> %CONFIG_DIR%whitelist.json & echo   logging: { >> %CONFIG_DIR%whitelist.json & echo     enabled: true, >> %CONFIG_DIR%whitelist.json & echo     log_path: C:ProgramDataBastionOpslogsaudit.log >> %CONFIG_DIR%whitelist.json & echo   }, >> %CONFIG_DIR%whitelist.json & echo   whitelisted_processes: [], >> %CONFIG_DIR%whitelist.json & echo   network_rules: { >> %CONFIG_DIR%whitelist.json & echo     block_all_outbound_by_default: true, >> %CONFIG_DIR%whitelist.json & echo     allowed_dns_resolvers: [1.1.1.1, 8.8.8.8] >> %CONFIG_DIR%whitelist.json & echo   }, >> %CONFIG_DIR%whitelist.json & echo   registry_monitor_paths: [ >> %CONFIG_DIR%whitelist.json & echo     HKEY_LOCAL_MACHINESOFTWAREMicrosoftWindowsCurrentVersionRun, >> %CONFIG_DIR%whitelist.json & echo     HKEY_CURRENT_USERSOFTWAREMicrosoftWindowsCurrentVersionRun >> %CONFIG_DIR%whitelist.json & echo   ], >> %CONFIG_DIR%whitelist.json & echo   protection_settings: { >> %CONFIG_DIR%whitelist.json & echo     enable_screen_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_keylog_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_process_injection_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_network_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_persistence_monitor: true, >> %CONFIG_DIR%whitelist.json & echo     scan_interval_ms: 1000, >> %CONFIG_DIR%whitelist.json & echo     auto_terminate_threats: true >> %CONFIG_DIR%whitelist.json & echo   } >> %CONFIG_DIR%whitelist.json & echo } >> %CONFIG_DIR%whitelist.json & echo [✓] Configuración por defecto creada. & exit /b & :End & cls & echo. & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        BastionOps - Sistema de Protección Avanzada           ║ & echo ║              ¡Gracias por usar BastionOps!                   ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Para más información: https://github.com/HackEvR-lgtm/BastionOps & echo. & timeout /t 3 >nul & exit /b 0