<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>CapabilityDenialSystem</AssemblyName>
    <RootNamespace>CapabilityDenialSystem</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>CDS Security Team</Authors>
    <Description>Capability Denial System - Advanced Host-Based Protection Against APTs and RATs</Description>
    <Copyright>Copyright 2024</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="Microsoft.Win32.Registry" />
  </ItemGroup>
  <ItemGroup>
    <None Update="whitelist.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
