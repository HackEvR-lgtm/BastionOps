@echo off & setlocal EnableDelayedExpansion & chcp 65001 >nul & title BastionOps - Inicializador Automatico Total & color 0B & echo. & echo ╔══════════════════════════════════════════════════════════════╗ & echo ║        BASTION OPS - Sistema de Proteccion Avanzada          ║ & echo ║         Inicializador Automatico Total v3.0                  ║ & echo ╚══════════════════════════════════════════════════════════════╝ & echo. & echo [*] Verificando privilegios de administrador... & net session >nul 2>&1 & if %errorLevel% neq 0 ( echo [!] Se requieren privilegios de Administrador. & echo [*] Reiniciando con elevacion automatica... & powershell -Command Start-Process '%~f0' -Verb runAs & exit /b ) & echo [OK] Privilegios de administrador confirmados. & echo. & set REPO_ROOT=%~dp0 & set SRC_DIR=%REPO_ROOT%src & set BUILD_DIR=%REPO_ROOT%build & set LOGS_DIR=%REPO_ROOT%logs & set CONFIG_DIR=%REPO_ROOT%config & set INSTALL_DIR=C:Program FilesBastionOps & set DATA_DIR=C:ProgramDataBastionOps & set LOG_FILE=%LOGS_DIR%auto_init_%date:~-4,4%%date:~-10,2%%date:~-7,2%_%time:~0,2%%time:~3,2%%time:~6,2%.log & set LOG_FILE=%LOG_FILE: =0% & if not exist %LOGS_DIR% mkdir %LOGS_DIR% & if not exist %BUILD_DIR% mkdir %BUILD_DIR% & if not exist %DATA_DIR% mkdir %DATA_DIR% & if not exist %DATA_DIR%logs mkdir %DATA_DIR%logs & echo [OK] Directorios de trabajo creados. & echo. & echo ============================================== & echo  PASO 1/5: Verificando .NET SDK               & echo ============================================== & where dotnet >nul 2>&1 & if %errorLevel% neq 0 ( echo [!] .NET SDK no encontrado. & echo [*] Descargando e instalando .NET 8.0 SDK... & powershell -Command Invoke-WebRequest -Uri 'https://download.visualstudio.microsoft.com/download/pr/0a1b2c3d/dotnet-sdk-8.0.100-win-x64.exe' -OutFile '%TEMP%dotnet-sdk.exe' & start /wait %TEMP%dotnet-sdk.exe /quiet /norestart & echo [OK] .NET SDK instalado. ) else ( echo [OK] .NET SDK detectado. ) & echo. & echo ============================================== & echo  PASO 2/5: Compilando proyecto User-Mode      & echo ============================================== & echo [*] Restaurando paquetes NuGet... & dotnet restore %SRC_DIR%usermodeCapabilityDenialSystem.csproj >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [ERROR] Fallo la restauracion de paquetes. & goto ErrorExit ) & echo [OK] Paquetes restaurados. & echo [*] Compilando en modo Release... & dotnet build %SRC_DIR%usermodeCapabilityDenialSystem.csproj -c Release --no-restore >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [ERROR] Fallo la compilacion. & goto ErrorExit ) & echo [OK] Compilacion exitosa. & echo [*] Publicando aplicacion standalone... & dotnet publish %SRC_DIR%usermodeCapabilityDenialSystem.csproj -c Release --self-contained true -r win-x64 -o %BUILD_DIR%usermode --no-build >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [ERROR] Fallo la publicacion. & goto ErrorExit ) & echo [OK] Publicacion completada. & echo [*] Copiando configuracion... & if exist %CONFIG_DIR%whitelist.json ( xcopy /Y %CONFIG_DIR%whitelist.json %BUILD_DIR%usermode >nul 2>&1 & echo [OK] Configuracion copiada. ) else ( call :CreateDefaultConfig & xcopy /Y %CONFIG_DIR%whitelist.json %BUILD_DIR%usermode >nul 2>&1 & echo [OK] Configuracion por defecto creada y copiada. ) & echo. & echo ============================================== & echo  PASO 3/5: Instalando servicio de Windows     & echo ============================================== & echo [*] Deteniendo servicio existente si hay... & sc stop BastionOps >nul 2>&1 & sc delete BastionOps >nul 2>&1 & echo [*] Creando directorio de instalacion... & if not exist %INSTALL_DIR% mkdir %INSTALL_DIR% & echo [OK] Directorio creado. & echo [*] Copiando archivos al sistema... & xcopy /E /I /Y %BUILD_DIR%usermode* %INSTALL_DIR% >nul 2>&1 & echo [OK] Archivos copiados. & echo [*] Registrando servicio BastionOps... & sc create BastionOps binPath= %INSTALL_DIR%CapabilityDenialSystem.exe start= auto DisplayName= BastionOps >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [ERROR] No se pudo crear el servicio. & goto ErrorExit ) & echo [OK] Servicio registrado. & echo [*] Configurando descripcion... & sc description BastionOps Sistema de Proteccion Avanzada contra Screen Capture, Keyloggers, Inyeccion de Procesos y Amenazas de Red. >nul 2>&1 & echo [OK] Descripcion configurada. & echo. & echo ============================================== & echo  PASO 4/5: Iniciando servicio                 & echo ============================================== & echo [*] Iniciando BastionOps... & sc start BastionOps >> %LOG_FILE% 2>&1 & if %errorLevel% neq 0 ( echo [ERROR] No se pudo iniciar el servicio. & goto ErrorExit ) & echo [OK] Servicio iniciado correctamente. & timeout /t 2 >nul & echo. & echo ============================================== & echo  PASO 5/5: Verificando estado                  & echo ============================================== & sc query BastionOps | findstr RUNNING >nul & if %errorLevel% equ 0 ( echo [OK] BastionOps esta ejecutandose correctamente. ) else ( echo [!] El servicio no aparece como RUNNING. Revisar manualmente. ) & echo. & echo ============================================== & echo  INSTALACION COMPLETADA                       & echo ============================================== & echo. & echo [OK] BastionOps protegiendo su sistema. & echo [OK] Logs en: %DATA_DIR%logs & echo [OK] Instalacion en: %INSTALL_DIR% & echo [OK] Log de esta sesion: %LOG_FILE% & echo. & echo Presione cualquier tecla para salir... & pause >nul & exit /b 0 & :ErrorExit & echo. & echo [ERROR] La instalacion fallo. Revise el log: & echo %LOG_FILE% & echo. & echo Presione cualquier tecla para salir... & pause >nul & exit /b 1 & :CreateDefaultConfig & echo { > %CONFIG_DIR%whitelist.json & echo   system_version: 1.0.0, >> %CONFIG_DIR%whitelist.json & echo   security_level: MAXIMUM_ISOLATION, >> %CONFIG_DIR%whitelist.json & echo   logging: { >> %CONFIG_DIR%whitelist.json & echo     enabled: true, >> %CONFIG_DIR%whitelist.json & echo     log_path: C:ProgramDataBastionOpslogsaudit.log >> %CONFIG_DIR%whitelist.json & echo   }, >> %CONFIG_DIR%whitelist.json & echo   whitelisted_processes: [], >> %CONFIG_DIR%whitelist.json & echo   network_rules: { >> %CONFIG_DIR%whitelist.json & echo     block_all_outbound_by_default: true, >> %CONFIG_DIR%whitelist.json & echo     allowed_dns_resolvers: [1.1.1.1, 8.8.8.8] >> %CONFIG_DIR%whitelist.json & echo   }, >> %CONFIG_DIR%whitelist.json & echo   registry_monitor_paths: [ >> %CONFIG_DIR%whitelist.json & echo     HKEY_LOCAL_MACHINESOFTWAREMicrosoftWindowsCurrentVersionRun, >> %CONFIG_DIR%whitelist.json & echo     HKEY_CURRENT_USERSOFTWAREMicrosoftWindowsCurrentVersionRun >> %CONFIG_DIR%whitelist.json & echo   ], >> %CONFIG_DIR%whitelist.json & echo   protection_settings: { >> %CONFIG_DIR%whitelist.json & echo     enable_screen_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_keylog_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_process_injection_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_network_protection: true, >> %CONFIG_DIR%whitelist.json & echo     enable_persistence_monitor: true, >> %CONFIG_DIR%whitelist.json & echo     scan_interval_ms: 1000, >> %CONFIG_DIR%whitelist.json & echo     auto_terminate_threats: true >> %CONFIG_DIR%whitelist.json & echo   } >> %CONFIG_DIR%whitelist.json & echo } >> %CONFIG_DIR%whitelist.json & exit /b